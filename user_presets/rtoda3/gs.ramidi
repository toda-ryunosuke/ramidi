# ====================================================================
# Ramidi Standard Library: Roland GS Standard
# ====================================================================

# --------------------------------------------------------------------
# 1. 音源リセット
# --------------------------------------------------------------------

# GS Mode Set (Reset)
DEF_MACRO, GS_RESET
  SYSEX, 0, 0, "F0 41 10 42 12 40 00 7F 00 41 F7"
END_MACRO


# --------------------------------------------------------------------
# 2. リバーブ・マクロ (Reverb Character) - 全8種
# --------------------------------------------------------------------

# 0: Room 1 (狭い部屋)
DEF_MACRO, GS_REVERB_ROOM1
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 00 0F F7"
END_MACRO

# 1: Room 2 (中くらいの部屋)
DEF_MACRO, GS_REVERB_ROOM2
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 01 0E F7"
END_MACRO

# 2: Room 3 (広い部屋)
DEF_MACRO, GS_REVERB_ROOM3
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 02 0D F7"
END_MACRO

# 3: Hall 1 (小コンサートホール)
DEF_MACRO, GS_REVERB_HALL1
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 03 0C F7"
END_MACRO

# 4: Hall 2 (大コンサートホール / 定番)
DEF_MACRO, GS_REVERB_HALL2
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 04 0B F7"
END_MACRO

# 5: Plate (プレート・金属板リバーブ)
DEF_MACRO, GS_REVERB_PLATE
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 05 0A F7"
END_MACRO

# 6: Delay (シンプルなディレイ)
DEF_MACRO, GS_REVERB_DELAY
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 06 09 F7"
END_MACRO

# 7: Pan Delay (左右に振れるステレオディレイ)
DEF_MACRO, GS_REVERB_PAN_DELAY
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 30 07 08 F7"
END_MACRO


# --------------------------------------------------------------------
# 3. コーラス・マクロ (Chorus Character) - 全8種
# --------------------------------------------------------------------

# 0: Chorus 1 (控えめなコーラス)
DEF_MACRO, GS_CHORUS_1
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 00 07 F7"
END_MACRO

# 1: Chorus 2 (標準的なコーラス)
DEF_MACRO, GS_CHORUS_2
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 01 06 F7"
END_MACRO

# 2: Chorus 3 (深めのコーラス)
DEF_MACRO, GS_CHORUS_3
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 02 05 F7"
END_MACRO

# 3: Chorus 4 (より広がりのあるコーラス)
DEF_MACRO, GS_CHORUS_4
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 03 04 F7"
END_MACRO

# 4: Feedback Chorus (波打つような強烈なコーラス)
DEF_MACRO, GS_CHORUS_FB
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 04 03 F7"
END_MACRO

# 5: Flanger (フランジャー効果 / ジェット音)
DEF_MACRO, GS_CHORUS_FLANGER
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 05 02 F7"
END_MACRO

# 6: Short Delay (ショートディレイ)
DEF_MACRO, GS_CHORUS_SHORT_DELAY
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 06 01 F7"
END_MACRO

# 7: FB Short Delay (フィードバック付きショートディレイ)
DEF_MACRO, GS_CHORUS_FB_DELAY
  SYSEX, 0, 0, "F0 41 10 42 12 40 01 38 07 00 F7"
END_MACRO