SET_TICK, 9, 960
NOTE, 9, 9, 0, 49, 127, 1920
CALL_MACRO, DRUM_BEAT, 3, 0, 0
CALL_MACRO, DRUM_FILL_1, 1, 0, 0
NOTE, 9, 9, 0, 49, 127, 1920
CALL_MACRO, DRUM_BEAT, 3, 0, 0
CALL_MACRO, DRUM_FILL_2, 1, 0, 0
