# 1. 爆走8ビートドラム (1小節)
DEF_MACRO, DRUM_BEAT
  NOTE, 9, 9,   0, 36, 127, 100
  ,,,           0, 42, 110, 100
  ,,,         240, 42, 100, 100
  ,,,         240, 38, 127, 100
  ,,,           0, 42, 110, 100
  ,,,         240, 42, 100, 100
  ,,,         240, 36, 120, 100
  ,,,           0, 42, 110, 100
  ,,,         240, 36, 110, 100
  ,,,           0, 42, 100, 100
  ,,,         240, 38, 127, 100
  ,,,           0, 46, 110, 100
  ,,,         240, 42, 100, 100
  CC,   9, 9, 240, 111, 0
END_MACRO

